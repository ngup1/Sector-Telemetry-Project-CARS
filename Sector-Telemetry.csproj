<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>SectorTelemetry</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Cached track outlines learned at runtime; never part of the build. -->
    <Content Remove="tracks/**" />
    <None Remove="tracks/**" />
  </ItemGroup>

</Project>
